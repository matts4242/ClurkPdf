### INTERFACE CONTRACTS

**API Response Format (consistent across all endpoints):**
```typescript
interface ApiResponse<T> {
  success: boolean;
  data?: T;
  error?: {
    code: string;
    message: string;
    details?: any;
  };
}
```

**Document Type Definition:**
```typescript
interface Document {
  id: string;                    // UUID v4
  filename: string;
  originalName: string;
  mimeType: string;
  size: number;                  // bytes
  pageCount: number;
  uploadPath: string;            // relative path from server root
  createdAt: string;             // ISO 8601 timestamp
  status: 'uploaded' | 'processing' | 'ready' | 'error';
}
```

**Component Props:**

```typescript
// FileDropzone.tsx
interface FileDropzoneProps {
  onFilesSelected: (files: File[]) => void;
  maxFileSize?: number;          // default: 10MB
  acceptedTypes?: string[];      // default: ['application/pdf']
  disabled?: boolean;
}

// DocumentViewer.tsx
interface DocumentViewerProps {
  documentId: string;
  onError?: (error: Error) => void;
  onPageChange?: (pageNumber: number) => void;
}

// UploadProgress.tsx
interface UploadProgressProps {
  fileName: string;
  progress: number;              // 0-100
  status: 'uploading' | 'processing' | 'complete' | 'error';
  errorMessage?: string;
}
```


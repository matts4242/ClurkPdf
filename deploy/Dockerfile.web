# Static front end plus the public entry point.
#
# Caddy serves the built single-page app and reverse-proxies /api and /uploads
# to the server container. That puts the API on the same origin as the page,
# which means no CORS in production and one port to open on the VPS. Caddy also
# gets a certificate on its own once SITE_ADDRESS is a real domain name.

FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY client/package.json client/package.json
RUN npm ci

COPY client/ client/

# Empty means "same origin", which is what the Caddy config below serves. The
# client falls back to http://localhost:3001 only when this is undefined.
ARG VITE_SERVER_ORIGIN=""
ARG VITE_PAGE_DPI=150
ENV VITE_SERVER_ORIGIN=${VITE_SERVER_ORIGIN}
ENV VITE_PAGE_DPI=${VITE_PAGE_DPI}

# No source maps: they would ship the whole client source to every visitor.
RUN npm run build --workspace client -- --sourcemap false


FROM caddy:2-alpine

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/client/dist /srv

EXPOSE 80 443

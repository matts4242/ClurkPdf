# Deployment settings, read by docker-compose.prod.yml.
#
# `scripts/deploy.sh` copies this to `.env` in the repository root on the first
# run and fills in a generated database password. Edit that file, not this one.

# Public address of the site.
#   :80                    plain HTTP on the VPS IP address (default)
#   invoices.example.com   HTTPS, certificate obtained and renewed by Caddy
# Point the domain's A record at the VPS before setting a hostname here, or the
# certificate request will fail.
SITE_ADDRESS=:80

# Origin the browser will use. Only matters when a hostname is set above.
PUBLIC_URL=http://localhost

# Host ports Caddy binds. Change HTTP_PORT if something else already owns 80.
HTTP_PORT=80
HTTPS_PORT=443

# Password for the bundled PostgreSQL container. Generated on first deploy.
# Keep it alphanumeric: it is interpolated into a connection URL.
POSTGRES_PASSWORD=

# Largest accepted upload, in bytes (10MB).
MAX_FILE_SIZE=10485760

# Render resolution for page images; the client is built against the same
# value, so changing it means rebuilding both containers.
PAGE_DPI=150

# How many documents in a batch are processed at once. Each one renders pages,
# so raise it only if the VPS has memory to spare.
BATCH_CONCURRENCY=2

# Most files accepted in one batch upload.
MAX_BATCH_FILES=50

# Tesseract language, e.g. `eng` or `eng+deu`.
OCR_LANGUAGE=eng

# How many regions are recognised at once. Each worker is a WASM instance, so
# raise this only if the VPS has cores and memory to spare.
OCR_CONCURRENCY=2

# Copy to `.env` beside this file, then edit. Compose reads it for the values
# it substitutes into compose.yaml, and passes the whole file to the api
# container, so everything the server reads can be set here.
#
#   cp .env.example .env
#
# Only the password below has to change. Every other line is the default the
# application already uses, written out so it can be found and adjusted.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# CHANGE THIS. Compose refuses to start without it, and a deployment that
# keeps the example value has a database anyone who has read this file can
# open. Stick to letters and digits: the password is built into a connection
# URL, so `@`, `:`, `/` and `?` would have to be percent-encoded.
POSTGRES_PASSWORD=change-me-before-deploying

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_USER=invoice
POSTGRES_DB=invoice_processor

# Maximum connections in the API's pool. Postgres allows 100 in total by
# default, so raise both together or not at all.
DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# The port the site is published on. Everything else stays inside the Compose
# network; this is the only way in.
WEB_PORT=8080

# The port the API listens on inside its container, which nginx proxies to.
# Not published, so it only needs changing if something in the image conflicts.
PORT=3001

# Browser origins the API accepts cross-origin requests from. Behind nginx the
# app is same-origin and none of this applies; it matters only when something
# else calls the API directly.
CLIENT_ORIGIN=http://localhost:8080

# Where the browser sends API requests. Empty means "wherever this page came
# from", which is what a deployment behind one proxy wants. Set it only when
# the API is served from a different host than the client.
VITE_SERVER_ORIGIN=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Largest accepted PDF, in bytes (10MB). Enforced by the API, which can say
# why it refused.
MAX_FILE_SIZE=10485760

# The same ceiling for nginx, in megabytes, and deliberately a little higher:
# a multipart request carries boundaries and headers on top of the file, and
# nginx cuts the connection rather than returning the API's error message.
# Raise this whenever MAX_FILE_SIZE goes up, or the increase does nothing.
MAX_UPLOAD_MB=12

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

# Resolution for page images. The spec floor is 150. The client is built with
# this same value, so changing it rebuilds the web image too.
PAGE_DPI=150

# Width in pixels of the page-1 preview generated on upload.
THUMBNAIL_WIDTH=150

# How long browsers may cache rendered page images, in seconds.
IMAGE_CACHE_SECONDS=86400

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------

# Tesseract language, e.g. `eng` or `eng+deu`. Data is downloaded on first use.
OCR_LANGUAGE=eng

# How many regions are recognised at once. Each worker is a WASM instance.
OCR_CONCURRENCY=2

# Give up on a single region after this long, in milliseconds.
OCR_TIMEOUT_MS=30000

# Crops narrower than this are upscaled first, because Tesseract is tuned for
# roughly 300dpi and pages render at PAGE_DPI.
OCR_MIN_CROP_WIDTH=1000

# ---------------------------------------------------------------------------
# Processing queue
# ---------------------------------------------------------------------------

# Namespace for this deployment's queue keys, so two deployments can share one
# Redis. Nothing else here does, so it rarely needs changing.
QUEUE_PREFIX=invoice

# How many documents are processed at once. Rendering a page holds a pdf.js
# document and a full-page canvas, so this is the api container's memory
# ceiling for a batch: raise it with RAM to spare, lower it if the container
# is being killed.
QUEUE_CONCURRENCY=3

# How many times a failed document is retried before it stays failed.
QUEUE_ATTEMPTS=3

# A job whose worker died is returned to the queue after this long.
QUEUE_JOB_TIMEOUT_MS=300000

# Pages rendered eagerly by the processing job. The rest render on demand when
# the viewer asks, so one long PDF cannot monopolise a worker.
EAGER_RENDER_PAGES=3

# How often the WebSocket server pings idle clients to prune dead sockets.
WS_HEARTBEAT_MS=30000

# ---------------------------------------------------------------------------
# Templates
# ---------------------------------------------------------------------------

# How well a page's header must match a saved template's vendor before the
# template is applied without being asked. The spec says 80%.
TEMPLATE_MATCH_THRESHOLD=0.8

# Weaker matches than this are not even offered as a suggestion.
TEMPLATE_SUGGEST_THRESHOLD=0.5

# How far a replayed template rectangle may search for its text, as a fraction
# of page height, when it lands on nothing.
TEMPLATE_SNAP_TOLERANCE=0.04

# Copy to .env and adjust as needed. Every value here is the built-in default.

# Port the API listens on.
PORT=3001

# Uploads root, relative to the server package.
UPLOADS_DIR=uploads

# Largest accepted upload, in bytes (10MB).
MAX_FILE_SIZE=10485760

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Render resolution for page images. The Week 1 spec floor is 150.
PAGE_DPI=150

# Width in pixels of the page-1 preview generated on upload.
THUMBNAIL_WIDTH=150

# How long browsers may cache rendered page images, in seconds.
IMAGE_CACHE_SECONDS=86400

# Copy to .env and adjust as needed.
#
# DATABASE_URL is required. Every other value here is the built-in default.
# Real environment variables take precedence over this file, which is how CI
# and production override it.

# PostgreSQL connection string. Matches the docker-compose service.
DATABASE_URL="postgresql://invoice:password@127.0.0.1:5432/invoice_processor?schema=public"

# Database used by `npm test`. Its name must end in `_test`; the suite refuses
# to run otherwise, because every test truncates the schema.
TEST_DATABASE_URL="postgresql://invoice:password@127.0.0.1:5432/invoice_processor_test?schema=public"

# Port the API listens on.
PORT=3001

# Maximum connections in the database pool.
DATABASE_POOL_SIZE=10

# Uploads root, relative to the server package.
UPLOADS_DIR=uploads

# Largest accepted upload, in bytes (10MB).
MAX_FILE_SIZE=10485760

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Render resolution for page images. The Week 1 spec floor is 150.
# The client's VITE_PAGE_DPI must match this.
PAGE_DPI=150

# Width in pixels of the page-1 preview generated on upload.
THUMBNAIL_WIDTH=150

# How long browsers may cache rendered page images, in seconds.
IMAGE_CACHE_SECONDS=86400

# --- OCR ---

# Tesseract language, e.g. `eng` or `eng+deu`.
OCR_LANGUAGE=eng

# Where Tesseract keeps its downloaded language data (~5MB, fetched once).
OCR_CACHE_DIR=.tesseract-cache

# How many regions are recognised at once. Each worker is a WASM instance.
OCR_CONCURRENCY=2

# Give up on a single region after this long, in milliseconds.
OCR_TIMEOUT_MS=30000

# Crops narrower than this are upscaled before recognition, because Tesseract
# is tuned for roughly 300dpi and pages render at PAGE_DPI.
OCR_MIN_CROP_WIDTH=1000
